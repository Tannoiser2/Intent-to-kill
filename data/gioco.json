 "moventi": [
  {
   "id": "rapinatore",
   "nome": "Rapinatore",
   "testo": "Non puoi uccidere nessuno che si trovi in un quartiere adiacente all'ultima Scena del Crimine.",
   "dettaglio": "Una vittima può trovarsi accanto a una Scena del Crimine solo se non è la più recente."
  },
  {
   "id": "estremista",
   "nome": "Estremista",
   "testo": "Almeno 3 delle vittime devono appartenere allo stesso gruppo sociale.",
   "dettaglio": "Si può scegliere chiunque finché resta possibile arrivare a 3 vittime dello stesso gruppo entro la quinta."
  },
  {
   "id": "sadico",
   "nome": "Sadico",
   "testo": "Non puoi uccidere civili intimiditi.",
   "dettaglio": ""
  },
  {
   "id": "cannibale",
   "nome": "Cannibale",
   "testo": "Tra le vittime devono esserci civili di tutte e tre le diverse corporature.",
   "dettaglio": "In qualsiasi ordine: si può scegliere chiunque finché restano abbastanza omicidi per completare le tre corporature."
  },
  {
   "id": "psicopatico",
   "nome": "Psicopatico",
   "testo": "Tutte le vittime devono essere al massimo di due età diverse.",
   "dettaglio": ""
  },
  {
   "id": "cultista",
   "nome": "Cultista",
   "testo": "La prima vittima deve appartenere a un gruppo sociale diverso da quello della Persona Segnalata. Ogni vittima deve appartenere a un gruppo sociale diverso rispetto all'ultima vittima. Devi uccidere la Persona Segnalata.",
   "dettaglio": "La Persona Segnalata si può uccidere in qualsiasi momento tranne nel primo round; se ci sono già 4 vittime deve essere lei la prossima."
  },
  {
   "id": "vigilante",
   "nome": "Vigilante",
   "testo": "Non puoi uccidere nessuno negli 8 quartieri che circondano (anche in diagonale) il segnalino Detective.",
   "dettaglio": ""
  },
  {
   "id": "tagliagole",
   "nome": "Tagliagole",
   "testo": "Non puoi uccidere nei 4 quartieri centrali della città.",
   "dettaglio": ""
  },
  {
   "id": "maniaco",
   "nome": "Maniaco",
   "testo": "Tutte le vittime devono essere dello stesso sesso.",
   "dettaglio": "La prima vittima può essere di entrambi i sessi."
  },
  {
   "id": "terrorista",
   "nome": "Terrorista",
   "testo": "Tutte le vittime devono appartenere a gruppi sociali diversi.",
   "dettaglio": ""
  },
  {
   "id": "killer",
   "nome": "Killer",
   "testo": "Puoi uccidere solo civili che si trovano da soli in un quartiere.",
   "dettaglio": ""
  },
  {
   "id": "spia",
   "nome": "Spia",
   "testo": "Tutte le vittime devono essere uccise in quartieri con edifici.",
   "dettaglio": ""
  }
